# Copy to .env.local and fill in. Never commit real values — .env and .env*.local
# are gitignored. Production values belong in your host's environment settings.

# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/database"

# --- Shopify ---
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://your-app-url.com"
SHOPIFY_SHOP_ID="your-shop.myshopify.com"
SHOPIFY_WEBHOOK_SECRET=""
SHOPIFY_SCOPES=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# --- PayPal payouts ---
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox" # or "live"

# --- Email (Resend) ---
# Transactional email for affiliate signups. If RESEND_API_KEY is unset, email
# is skipped with a warning and everything else keeps working.
RESEND_API_KEY=""
# Must be on a domain verified in Resend, or sends are rejected. Note that
# verifying a subdomain does not authorize the apex domain, or vice versa.
RESEND_FROM_EMAIL="Fleur Affiliates <team@resend.yourdomain.com>"
# Where "new application" notices go. Comma-separate for more than one
# recipient. Defaults to the first admin user's email when blank.
ADMIN_NOTIFICATION_EMAIL="you@yourdomain.com,teammate@yourdomain.com"

# ---------------------------------------------------------------------------
# Creator outreach (Trybe seeding at volume)
# ---------------------------------------------------------------------------
# Instagram profile lookup. Either APIFY_TOKEN or APIFY_API_KEY works — the
# other scrapers in this workspace use APIFY_API_KEY, so that name is accepted
# too. Leave both blank to disable stage 2 entirely.
APIFY_TOKEN=""
# NOTE: apify~instagram-profile-scraper returns NO email field — verified live.
# Use a contact scraper that exposes public_email.
APIFY_INSTAGRAM_ACTOR="devil_port369-owner~instagram-email-phone-scraper-pay-per-result"

# The Trybe invite/join link the outreach email points creators at.
TRYBE_JOIN_URL="https://jointrybe.com/..."

# Cold outreach sends from its OWN verified domain, kept separate from
# transactional mail. Sharing a domain means a bad outreach week takes payout
# notifications down with it — the separation is the whole point.
CREATOR_OUTREACH_FROM="Fleur Creator Team <creators@mail.yourdomain.com>"
CREATOR_OUTREACH_REPLY_TO="creators@yourdomain.com"
# Optional: a separate Resend key scoped to the outreach domain. Falls back to
# RESEND_API_KEY when blank.
CREATOR_OUTREACH_RESEND_API_KEY=""

# Required by CAN-SPAM — every commercial email must carry a valid physical
# postal address. Sends are refused outright when this is blank.
CREATOR_OUTREACH_POSTAL_ADDRESS="Fleur, 123 Example St, City, ST 00000"

# Public base URL used to build unsubscribe links. Falls back to SHOPIFY_APP_URL.
CREATOR_OUTREACH_PUBLIC_URL="https://affiliates.yourdomain.com"

# Rolling 24-hour send cap and the pause between sends (jittered ±50%).
# Start low on a fresh domain — 20-30/day for the first week — and ramp.
CREATOR_OUTREACH_DAILY_CAP="100"
CREATOR_OUTREACH_SEND_DELAY_MS="15000"

# Only needed if several shops share this database; scripts otherwise infer it.
SHOPIFY_SHOP_ID=""
